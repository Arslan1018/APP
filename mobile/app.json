{
  "expo": {
    "name": "ARMenu",
    "slug": "armenu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.armenu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ARMenu uses your camera to show food in augmented reality.",
        "NSMicrophoneUsageDescription": "ARMenu may use the microphone during AR sessions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.armenu.app",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-barcode-scanner",
        { "cameraPermission": "Allow ARMenu to access camera for QR scanning." }
      ]
    ],
    "scheme": "armenu",
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": { "projectId": "your-eas-project-id" }
    }
  }
}
